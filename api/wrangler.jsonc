{
  "name": "commoncam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      // Placeholder until the Cloudflare provisioning ticket creates the real database.
      "database_name": "commoncam",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // App Store signed transactions must chain to this root (Apple Root CA - G3, DER base64,
    // SHA-256 63343abf…3e9179 from https://www.apple.com/certificateauthority/). Tests swap in a fake root.
    "APPLE_ROOT_CA_G3": "",
    "APPLE_BUNDLE_ID": "app.commoncam.CommonCam"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "commoncam-media"
    }
  ]
}
